{
  "config": {
    "api": {
      "allow_writes": true,
      "secret_dirs": [
        "/etc/falcosidekick/secrets"
      ]
    },
    "database": {
      "backend": "postgres",
      "connect_timeout": 30000000000,
      "postgres": {
        "database": "falcosidekick",
        "host": "postgres.falco.svc",
        "max_connections": 4,
        "password": "****",
        "poll_interval": 10000000000,
        "port": 5432,
        "sslmode": "verify-full",
        "tls": {
          "ca_file": "/etc/falcosidekick/secrets/postgres-tls/ca.crt"
        },
        "user": "sidekick"
      },
      "sqlite": {
        "path": ""
      }
    },
    "listen_address": "0.0.0.0",
    "listen_port": 2801,
    "log_format": "text",
    "log_level": "info",
    "management": {
      "listen_address": "127.0.0.1",
      "listen_port": 2802
    },
    "metrics": {
      "extra_labels": [
        "cluster"
      ],
      "max_label_values": 1000
    },
    "provisioning": {
      "allow_ui_updates": false
    },
    "reload": {
      "poll_interval": 30000000000,
      "retire_timeout": 10000000000
    },
    "runtime_defaults": {
      "batching": {
        "batch_size": 50,
        "enabled": true,
        "flush_interval": 1000000000
      },
      "circuit_breaker": {
        "failure_threshold": 5,
        "reset_timeout": 30000000000,
        "success_threshold": 2
      },
      "health_check": true,
      "minimum_priority": "warning",
      "queue_size": 100,
      "retry": {
        "initial_interval": 10000000,
        "max_attempts": 1,
        "max_interval": 100000000,
        "multiplier": 2
      },
      "workers": 1
    },
    "tls": {
      "ca_file": "",
      "cert_file": "/etc/falcosidekick/certs/tls.crt",
      "enabled": true,
      "key_file": "/etc/falcosidekick/certs/tls.key",
      "mutual_tls": false
    },
    "ui": {
      "enabled": false,
      "event_source": "inmemory"
    }
  }
}
