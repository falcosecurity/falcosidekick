{
  "category": "webhook",
  "name": "webhook",
  "schema": {
    "fields": [
      {
        "label": "Host (scheme, host and port)",
        "name": "host",
        "required": true,
        "type": "string"
      },
      {
        "label": "Base Path",
        "name": "base_path",
        "required": false,
        "type": "string"
      },
      {
        "default": "/",
        "label": "Endpoint",
        "name": "endpoint",
        "required": false,
        "type": "string"
      },
      {
        "label": "Secret Endpoint",
        "name": "secret_endpoint",
        "required": false,
        "secret": true,
        "type": "string"
      },
      {
        "entry_fields": [
          {
            "label": "Public Values",
            "name": "values",
            "required": false,
            "type": "string[]"
          },
          {
            "label": "Secret Values",
            "name": "secrets",
            "required": false,
            "secret": true,
            "type": "string[]"
          },
          {
            "file": true,
            "label": "Secret File Paths",
            "name": "files",
            "required": false,
            "type": "string[]"
          }
        ],
        "label": "Query Parameters",
        "name": "query_params",
        "required": false,
        "type": "map"
      },
      {
        "default": "POST",
        "label": "HTTP Method",
        "name": "method",
        "required": false,
        "type": "enum",
        "values": [
          "POST",
          "PUT"
        ]
      },
      {
        "label": "Username (Basic Auth)",
        "name": "username",
        "required": false,
        "type": "string"
      },
      {
        "label": "Password (Basic Auth)",
        "name": "password",
        "required": false,
        "secret": true,
        "type": "string"
      },
      {
        "label": "Bearer Token",
        "name": "bearer_token",
        "required": false,
        "secret": true,
        "type": "string"
      },
      {
        "entry_fields": [
          {
            "label": "Public Values",
            "name": "values",
            "required": false,
            "type": "string[]"
          },
          {
            "label": "Secret Values",
            "name": "secrets",
            "required": false,
            "secret": true,
            "type": "string[]"
          },
          {
            "file": true,
            "label": "Secret File Paths",
            "name": "files",
            "required": false,
            "type": "string[]"
          }
        ],
        "label": "Custom HTTP Headers",
        "name": "headers",
        "required": false,
        "type": "map"
      },
      {
        "default": false,
        "label": "Skip TLS Certificate Verification",
        "name": "tls.insecure_skip_verify",
        "required": false,
        "type": "bool"
      },
      {
        "file": true,
        "label": "CA Certificate File",
        "name": "tls.ca_file",
        "required": false,
        "type": "string"
      },
      {
        "file": true,
        "label": "Client Certificate File (mTLS)",
        "name": "tls.cert_file",
        "required": false,
        "type": "string"
      },
      {
        "file": true,
        "label": "Client Key File (mTLS)",
        "name": "tls.key_file",
        "required": false,
        "type": "string"
      },
      {
        "label": "Server Name Override",
        "name": "tls.server_name",
        "required": false,
        "type": "string"
      },
      {
        "label": "Minimum Priority",
        "name": "runtime.minimum_priority",
        "required": false,
        "type": "enum",
        "values": [
          "debug",
          "informational",
          "notice",
          "warning",
          "error",
          "critical",
          "alert",
          "emergency"
        ]
      },
      {
        "default": 1000,
        "label": "Queue Size",
        "name": "runtime.queue_size",
        "required": false,
        "type": "int"
      },
      {
        "default": 2,
        "label": "Worker Count",
        "name": "runtime.workers",
        "required": false,
        "type": "int"
      },
      {
        "default": 3,
        "label": "Max Retry Attempts",
        "name": "runtime.retry.max_attempts",
        "required": false,
        "type": "int"
      },
      {
        "default": "1s",
        "label": "Retry Initial Interval",
        "name": "runtime.retry.initial_interval",
        "required": false,
        "type": "string"
      },
      {
        "default": "30s",
        "label": "Retry Max Interval",
        "name": "runtime.retry.max_interval",
        "required": false,
        "type": "string"
      },
      {
        "default": 2,
        "label": "Retry Backoff Multiplier",
        "name": "runtime.retry.multiplier",
        "required": false,
        "type": "float"
      },
      {
        "default": 5,
        "label": "Circuit Breaker Failure Threshold",
        "name": "runtime.circuit_breaker.failure_threshold",
        "required": false,
        "type": "int"
      },
      {
        "default": 2,
        "label": "Circuit Breaker Success Threshold",
        "name": "runtime.circuit_breaker.success_threshold",
        "required": false,
        "type": "int"
      },
      {
        "default": "30s",
        "label": "Circuit Breaker Reset Timeout",
        "name": "runtime.circuit_breaker.reset_timeout",
        "required": false,
        "type": "string"
      },
      {
        "default": false,
        "label": "Enable Batching",
        "name": "runtime.batching.enabled",
        "required": false,
        "type": "bool"
      },
      {
        "default": 500,
        "label": "Batch Size",
        "name": "runtime.batching.batch_size",
        "required": false,
        "type": "int"
      },
      {
        "default": "1s",
        "label": "Batch Flush Interval",
        "name": "runtime.batching.flush_interval",
        "required": false,
        "type": "string"
      },
      {
        "default": true,
        "label": "Probe the destination before starting",
        "name": "runtime.health_check",
        "required": false,
        "type": "bool"
      }
    ]
  }
}
